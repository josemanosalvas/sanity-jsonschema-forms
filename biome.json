{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {"enabled": true, "clientKind": "git", "useIgnoreFile": true},
  "files": {"includes": ["**", "!**/dist", "!.claude", "!pnpm-lock.yaml"]},
  "formatter": {"indentStyle": "space", "lineWidth": 140},
  "javascript": {
    "formatter": {"semicolons": "asNeeded", "quoteStyle": "single", "bracketSpacing": false, "trailingCommas": "all"}
  },
  "json": {"formatter": {"bracketSpacing": false}},
  "css": {"parser": {"tailwindDirectives": true}},
  "linter": {
    "enabled": true,
    "rules": {"preset": "recommended", "style": {"noNonNullAssertion": "off", "noDescendingSpecificity": "off"}}
  },
  "assist": {"actions": {"source": {"organizeImports": "on"}}}
}
