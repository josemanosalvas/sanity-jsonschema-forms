{
  "name": "sanity-jsonschema-forms",
  "version": "0.0.0",
  "private": true,
  "description": "Standards-based form authoring for Sanity: @sanity/form-toolkit compiled to JSON Schema, with adapters for schema-driven form libraries.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --filter \"./packages/*\" test",
    "dev": "pnpm --filter compare-example dev",
    "release": "pnpm build && pnpm --filter sanity-json-schema publish"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.12",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@11.25.0"
}
