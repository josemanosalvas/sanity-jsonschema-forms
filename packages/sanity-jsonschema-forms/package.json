{
  "name": "sanity-jsonschema-forms",
  "version": "0.2.1",
  "description": "Compile @sanity/form-toolkit forms to JSON Schema, with adapters for RJSF and JSON Forms.",
  "keywords": [
    "form-toolkit",
    "forms",
    "json-schema",
    "jsonforms",
    "react-jsonschema-form",
    "rjsf",
    "sanity"
  ],
  "homepage": "https://github.com/josemanosalvas/sanity-jsonschema-forms#readme",
  "bugs": {
    "url": "https://github.com/josemanosalvas/sanity-jsonschema-forms/issues"
  },
  "license": "MIT",
  "author": "José Manosalvas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/josemanosalvas/sanity-jsonschema-forms.git",
    "directory": "packages/sanity-jsonschema-forms"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./rjsf": "./src/rjsf.ts",
    "./jsonforms": "./src/jsonforms.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./rjsf": {
        "types": "./dist/rjsf.d.ts",
        "default": "./dist/rjsf.js"
      },
      "./jsonforms": {
        "types": "./dist/jsonforms.d.ts",
        "default": "./dist/jsonforms.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "publint": "publint --pack pnpm --strict"
  },
  "dependencies": {
    "@types/json-schema": "^7.0.15"
  },
  "devDependencies": {
    "@jsonforms/core": "3.8.0",
    "@jsonforms/react": "3.8.0",
    "@jsonforms/vanilla-renderers": "3.8.0",
    "@rjsf/core": "^6.8.0",
    "@rjsf/shadcn": "^6.8.0",
    "@rjsf/utils": "^6.8.0",
    "@rjsf/validator-ajv8": "^6.8.0",
    "@sanity/form-toolkit": "^3.0.17",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "ajv": "8.20.0",
    "ajv-formats": "2.1.1",
    "fast-check": "^4.9.0",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sanity-form-fixtures": "workspace:*",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "@jsonforms/core": "^3.8.0",
    "@rjsf/utils": "^6.8.0"
  },
  "peerDependenciesMeta": {
    "@jsonforms/core": {
      "optional": true
    },
    "@rjsf/utils": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12"
  }
}
